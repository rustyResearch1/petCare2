# Postgres connection string. Leave unset to use the embedded local database in ./.data (dev only).
DATABASE_URL=

# Claude API key for reading uploaded vaccine/medical records.
ANTHROPIC_API_KEY=
# Optional model override for record extraction.
EXTRACTION_MODEL=claude-sonnet-5-5

# Login for the /ops dashboard (HTTP basic auth).
OPS_USER=ops
OPS_PASSWORD=change-me

# Public base URL, used to build owner status links.
PUBLIC_BASE_URL=http://localhost:3000
PGSSL=

# File storage (any S3-compatible bucket: Railway Buckets, Cloudflare R2, AWS S3).
# Leave unset to keep uploads in Postgres (fine for local development).
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Accounts (Better Auth). Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Google sign-in. Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (Resend). Without a key, emails and sign-in codes are written to the server log.
RESEND_API_KEY=
EMAIL_FROM=Settled <hello@yourdomain.com>
# Where team alerts go (new setups, assistant requests, payments).
OPS_NOTIFY_EMAIL=

# Payments (Stripe Checkout). Webhook URL: <PUBLIC_BASE_URL>/api/stripe/webhook, event checkout.session.completed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional model overrides.
ASSISTANT_MODEL=claude-sonnet-5-5
